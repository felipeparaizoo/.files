[
  {
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "exclusive": true,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
      "mpris",
      "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "disk",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "☦︎",
            "default": "♱",
            "empty": "󰝥"
        }
    },

    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %H:%M:%S}",
        "tooltip": false
    },

    "cpu": {
        "interval": 1,
        "format": "󰻠 {usage}%",
        "tooltip": false,
        "on-click": "kitty btop"
    },

    "memory": {
        "interval": 1,
        "format": "󰍛 {percentage}% ({used:0.1f}G)",
        "tooltip": false
    },

    "network": {
      "interval": 1,
      "format-ethernet": "󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
      "format-wifi": "󰖩 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
      "format-disconnected": "󰌺 desconectado",
      "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mudo",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip": false
    },

    "tray": {
        "spacing": 8
    }, 

    "mpris": {
      "interval": 1,
      "format": "{player_icon} {title}",
      "format-paused": "󰏤 {title}",
      "player-icons": {
        "spotify": "󰓇",
        "firefox": "󰈹",
        "default": "󰎇"
      },
      "max-length": 20,
      "tooltip": false,
    },

    "disk": {
      "interval": 30,
      "format": "󰋊 {percentage_used}%",
      "path": "/",
      "tooltip": false,
    }
  },
 ]
